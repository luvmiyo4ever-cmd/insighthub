# Keep the real value in a local .env file or a managed secret; never commit it.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_BOT_USER_ID=
# Optional local override. Compose persists the default worker log in its
# named volume at /app/audit/chatops-audit.log.
CHATOPS_AUDIT_LOG_PATH=/app/audit/chatops-audit.log
CHATOPS_MUTATOR_URL=http://host.docker.internal:18083/v1/actions/scale-api
CHATOPS_MUTATION_SIGNING_SECRET=
